# Copiá este archivo a .env y completá tus API keys antes de levantar el sistema.
# El archivo .env está en .gitignore: nunca subas tus API keys al repositorio.

# --- Redis (estado de jobs + checkpointer de LangGraph) ---
REDIS_URL=redis://localhost:6379/0
JOB_TTL_SECONDS=86400

# --- Proveedor de LLM para los agentes (chat): gemini | anthropic | openai ---
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-2.5-flash

# Se obtiene gratis en https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Opcional: si tu key gratuita se queda sin cuota (429), podés agregar keys
# adicionales (de otros proyectos de AI Studio) y el sistema rota
# automáticamente a la siguiente cuando la actual se agota.
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=

# Alternativas (solo si cambiás MODEL_PROVIDER)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- RAG: embeddings (siempre Gemini, independiente de MODEL_PROVIDER) ---
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
RAG_DATA_DIR=./data
RAG_PERSIST_DIR=./vectorstore
RAG_COLLECTION_NAME=higiene_seguridad_industrial
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=4

# --- Salvaguardas del Supervisor contra el "Supervisor Infinito" ---
MAX_STEPS=6
MAX_REFINEMENTS=1

# --- Observabilidad: langsmith | phoenix | none ---
OBSERVABILITY_BACKEND=langsmith

# LangSmith (https://smith.langchain.com)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=higiene-seguridad-intelligence-system

# Arize Phoenix (self-hosted, si OBSERVABILITY_BACKEND=phoenix)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=higiene-seguridad-intelligence-system
